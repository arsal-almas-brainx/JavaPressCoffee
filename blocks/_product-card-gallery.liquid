{% assign product = closest.product %}

{%- style -%}
  /* Custom Raleway styles for this specific card */
  .custom-card-{{ section.id }} {
    font-family: 'Raleway', sans-serif;
    display: flex;
    flex-direction: column;
    padding: 10px;
    background: #fff;
    position: relative;
  }

  .rel-img-container {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background-color: #f5f5f5;
    display: block;
  }

  .rel-img-container img,
  .rel-img-manual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dynamic Tag Badge Styling */
  .dynamic-tag-badge-manual {
    position: absolute;
    top: 12px;
    left: 0px;
    background: #FAE5B9;
    color: #424242;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
    z-index: 2;
    border-radius: 2px;
    text-transform: uppercase;
    pointer-events: none;
  }

  .rel-title {
    font-size: 18px;
    font-weight: 700 !important;
    margin: 15px 0 5px 0;
    color: #424242;
    text-decoration: none;
    line-height: 1.25;
  }

  .rel-review-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .rel-star {
    width: 14px;
    height: 14px;
    fill: #EF4444;
  }

  .rel-price-row {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: auto;
    margin-bottom: 15px;
  }

  .rel-price {
    font-size: 19px;
    font-weight: 700 !important;
    color: #000;
    margin: 0;
  }

  .rel-compare-price {
    text-decoration: line-through;
    color: #929292;
    font-size: 13px;
    font-weight: 400;
    margin: 0;
  }

  .rel-add-btn {
    width: 100%;
    font-family: 'Raleway', sans-serif;
    font-weight: 800 !important;
    padding: 12px;
    color: #FFF;
    background-color: #EF4444;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    transition: opacity 0.3s;
  }

  .rel-add-btn:hover {
    opacity: 0.9;
  }
  @media screen and (max-width: 767px){
    .custom-card-{{ section.id }} {padding: 5px;}
    .rel-review-row p{font-size: 12px !important;}
    .rel-star {width: 12px; height: 12px;}
    .rel-price{font-size: 16px}
    .rel-compare-price{font-size: 14px;}
    .rel-title{padding-top: 5%;}
    .dynamic-tag-badge-manual{display: none;}
  }
{%- endstyle -%}

<div class="custom-card-{{ section.id }}">
  {% unless product == blank %}
    {% comment %} Image Link with Badge {% endcomment %}
    <a href="{{ product.url }}" class="rel-img-container">
      {%- if product.tags.size > 0 -%}
        <span class="dynamic-tag-badge-manual">{{ product.tags | first }}</span>
      {%- endif -%}

      {{
        product.featured_image
        | image_url: width: 600
        | image_tag:
          loading: 'lazy',
          alt: product.title,
          class: 'rel-img-manual',
          width: product.featured_image.width,
          height: product.featured_image.height
      }}
    </a>

    {% comment %} Title Link {% endcomment %}
    <a href="{{ product.url }}" style="text-decoration: none; color: inherit;">
      <h4 class="rel-title">{{ product.title }}</h4>
    </a>

    {% comment %} Reviews Section {% endcomment %}
    <div class="rel-review-row">
      <div style="display:flex; gap: 0px;">
        {% for i in (1..5) %}
          <svg class="rel-star" viewBox="0 0 24 24">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
          </svg>
        {% endfor %}
      </div>
      <p style="font-size: 13px; font-weight:700; margin:0; color: #424242;">
        ( <u>{{ product.metafields.custom.review_count.value | default: '1171' }} Reviews</u> )
      </p>
    </div>

    {% comment %} Pricing Section {% endcomment %}
    <div class="rel-price-row">
      <p class="rel-price">{{ product.price | money }}</p>
      {% if product.compare_at_price > product.price %}
        <p class="rel-compare-price">
          {{- product.compare_at_price | money -}}
        </p>
      {% endif %}
    </div>

    {% comment %} Add to Cart Form {% endcomment %}
    <form method="post" action="{{ routes.cart_add_url }}">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="rel-add-btn">ADD TO CART</button>
    </form>

  {% else %}
    {% comment %} Placeholder for Theme Editor {% endcomment %}
    <div class="rel-img-container" style="background:#eee;"></div>
    <h4 class="rel-title">Example Product Title</h4>
    <div class="rel-price-row"><p class="rel-price">$19.99</p></div>
    <button class="rel-add-btn" disabled>ADD TO CART</button>
  {% endunless %}
</div>
<script>
  if (!window.productCardGalleryInitialized) {
    document.addEventListener('submit', (e) => {
      // This checks if the submitted form is an "Add to Cart" form
      const form = e.target;
      if (form.action && form.action.includes('/cart/add')) {
        e.preventDefault();

        const btn = form.querySelector('.rel-add-btn');
        const formData = new FormData(form);

        if (btn) {
          btn.innerText = 'ADDING...';
          btn.style.opacity = '0.7';
          btn.disabled = true; // Prevent double-clicks
        }

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: formData,
        })
          .then((response) => {
            if (!response.ok) throw new Error('Add to cart failed');
            return response.json();
          })
          .then((data) => {
            if (btn) btn.innerText = 'ADDED!';

            // This triggers your Cart Drawer logic from the first file
            if (typeof refreshCartDrawer === 'function') {
              refreshCartDrawer(true);
            }

            setTimeout(() => {
              if (btn) {
                btn.innerText = 'ADD TO CART';
                btn.style.opacity = '1';
                btn.disabled = false;
              }
            }, 1500);
          })
          .catch((error) => {
            console.error('Error:', error);
            if (btn) {
              btn.innerText = 'ERROR';
              btn.disabled = false;
            }
          });
      }
    });
    window.productCardGalleryInitialized = true;
  }
</script>

{% schema %}
{
  "name": "Custom Product Card",
  "settings": [
    {
      "type": "paragraph",
      "content": "This card uses the Custom Red Design with Badge support."
    }
  ],
  "presets": [
    {
      "name": "Custom Product Card"
    }
  ]
}
{% endschema %}
