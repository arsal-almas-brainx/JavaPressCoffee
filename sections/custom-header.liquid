{%- style -%}
    @import url('https://fonts.googleapis.com/css2?family=Comforter&display=swap');

    :root {
      --drawer-bg: #ffffff;
      --drawer-text: #000000;
      --accent-red: #EF4444;
      --dropdown-bg: #ffffff;
    }

    .custom-header-container {
      background-color: {{ section.settings.bg_color }};
      border-bottom: 1px solid #e8e8e8;
      padding: {{ section.settings.padding_y }}px 4%;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .custom-grid-header {
      display: grid;
      grid-template-columns: 1.2fr 1.3fr 3.2fr 0.3fr 1.7fr;
      align-items: center;
      max-width: 1400px;
      margin: 0 auto;
      width: 100%;
    }

    .header-grid__logo a { text-decoration: none; color: {{ section.settings.text_color }}; }
    .header-grid__logo img { max-width: 100%; height: auto; display: block; }

    .logo-text-custom {
      font-family: 'Comforter', cursive !important;
      font-size: 32px;
      font-weight: 600;
      line-height: 1;
      white-space: nowrap;
      padding-left: 20%;
    }

    /* DESKTOP MENU */
    .header-grid__menu {
      display: flex;
      justify-content: flex-start;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: 45px;
    }
    .menu-item-has-children { position: relative; }

    .header-grid__menu a {
      text-decoration: none;
      color: {{ section.settings.text_color }};
      font-family: 'Raleway', sans-serif;
      font-weight: 500;
      font-size: 16px;
      position: relative;
      transition: all 0.2s ease-in-out;
      display: inline-block;
      padding-bottom: 10px;
      cursor: pointer;
    }

    .header-grid__menu a::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%) scale(0);
      width: 6px;
      height: 6px;
      background-color: var(--accent-red);
      border-radius: 50%;
      transition: transform 0.2s ease-in-out;
    }

    .header-grid__menu a:hover { color: var(--accent-red); font-weight: 700; }
    .header-grid__menu a:hover::after,
    .menu-item-has-children.is-open > a::after { transform: translateX(-50%) scale(1); }
    .dropdown-menu li a:hover{ color: white; font-weight: 600; background-color: #05433F;}

    /* DROPDOWN STYLING */
    .dropdown-menu {
      position: absolute;
      top: 100%;
      left: 0;
      background: var(--dropdown-bg);
      box-shadow: 0 10px 20px rgba(0,0,0,0.1);
      min-width: 160px;
      list-style: none;
      padding: 15px 0;
      margin: 0;
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: all 0.3s ease;
      z-index: 10;
      border-radius: 4px;
      text-align: left;
    }

    .menu-item-has-children.is-open .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    /* CART BUBBLE STYLING */
  .cart-count-bubble {
    position: absolute;
    top: -5px;
    right: -8px;
    background-color: #000;
    color: #fff;
    font-size: 10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    line-height: 1;
  }

  /* Hide bubble if it's empty or zero */
  .cart-count-bubble:empty,
  .cart-count-bubble[data-count="0"] {
    display: none;
  }

  /* Hover effect from old navigation */
  .header-grid__cart a { transition: transform 0.2s; }
  .header-grid__cart a:hover { transform: scale(1.1); }

    .dropdown-menu li a {
      padding: 10px 20px;
      display: block;
      width: 100%;
      font-size: 16px;
      margin-bottom: 0;
      font-weight: 400;
    }
    .dropdown-menu li a::after { display: none !important; }

    /* MOBILE HAMBURGER */
    .mobile-menu-trigger {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      color: {{ section.settings.text_color }};
    }

    /* CART & ACTION BTN */
    .header-grid__cart { grid-column: 4; justify-self: center; position: relative; }
    .header-grid__cart a { display: block; color: var(--accent-red); }
    .header-grid__cart svg { width: 28px; height: 28px; stroke-width: 2; display: block; }

    .header-grid__btn {
      grid-column: 5;
      background-color: {{ section.settings.btn_bg_color }};
      color: {{ section.settings.btn_text_color }};
      padding: 12px 10px;
      text-decoration: none;
      border-radius: 4px;
      font-weight: 800;
      text-align: center;
      font-size: 16px;
      font-family: 'Raleway', sans-serif;
      margin-right: 20%;
    }

    /* DRAWER */
    .mobile-drawer {
      position: fixed;
      top: 0; left: -100%; width: 85%; max-width: 400px; height: 100vh;
      background: var(--drawer-bg); z-index: 1000; transition: left 0.3s ease;
      display: flex; flex-direction: column;
    }
    .mobile-drawer.is-active { left: 0; }
    .drawer-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(0,0,0,0.5); z-index: 999; display: none;
    }
    .drawer-overlay.is-active { display: block; }
    .drawer-header { padding: 20px; display: flex; align-items: center; border-bottom: 1px solid #eee; }
    .drawer-close { background: none; border: none; font-size: 24px; cursor: pointer; }
    .drawer-title { flex-grow: 1; text-align: center; font-weight: 700; font-size: 18px; margin-right: 24px; }
    .drawer-body { flex-grow: 1; overflow-y: auto; padding: 10px 20px; }
    .drawer-row {
      display: flex; justify-content: space-between; align-items: center; padding: 18px 0;
      border-bottom: 1px solid #f5f5f5; text-decoration: none; color: var(--drawer-text);
      font-family: 'Raleway', sans-serif; font-weight: 400; font-size: 18px;
    }
    .ph-arrow-right { transform: rotate(90deg); width: 22px; height: 22px; }

    .drawer-footer { padding: 20px; border-top: 1px solid #eee; background: #ededed; display: flex; flex-direction: column; align-items: start; }
    .footer-action { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; text-decoration: none; color: #424242; font-weight: 400; font-family: 'Raleway', sans-serif; font-size: 12px; }
    .login-svg{ border: 1px solid black; border-radius: 50%;}

    .social-icons a { display: block; width: 22px; height: 22px; color: #000; }
    .social-icons svg { width: 100%; height: 100%; fill: currentColor; display: block; }
    .drawer-localization { width: 100%; display: flex; padding: 10px 0; margin-bottom: 15px; border-top: 1px solid #f0f0f0; border-bottom: 1px solid #f0f0f0;}
    .localization-trigger { display: flex; align-items: center; gap: 6px; cursor: pointer; font-family: 'Raleway', sans-serif; font-size: 14px; font-weight: 500; color: #000;}
    .dropdown-triangle { margin-top: 2px; /* Slight alignment tweak for the triangle */}
    .social-icons { display: flex; gap: 10px; justify-content: center; }
    .social-icons a { display: block; width: 22px; height: 22px; color: #000; }
    @media screen and (max-width: 992px){
      .header-grid__btn{margin-right: 0;}
      .header-grid__menu-wrapper { display: none; }
      .mobile-menu-trigger { display: block; grid-column: 1; }
      .header-grid__cart a {transform: translateX(-50%);}
      .logo-text-custom{padding-left: 117%;}
      .drawer-header .logo-text-custom{padding-left: 0; font-size: 30px;}
    }
    @media screen and (max-width: 767px) {
      
      .header-grid__logo { grid-column: 2; justify-self: center; }
      .logo-text-custom { padding-left: 50%; font-size: 24px; }
      .header-grid__cart { grid-column: 4; justify-self: end; transform: translateX(50%); }
      .header-grid__btn { grid-column: 5;  font-size: 12px; padding: 8px 5px; }
      .custom-grid-header { grid-template-columns: 40px 1fr 0.1fr 40px 100px; gap: 10px; }
      .drawer-header .drawer-title.logo-text-custom {padding-left: 0;}
    }
{%- endstyle -%}

<div class="custom-header-container">
  <header class="custom-grid-header">
    <button class="mobile-menu-trigger" id="openDrawer" aria-label="Menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <div class="header-grid__logo">
      <a href="{{ routes.root_url }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy' }}
        {% else %}
          <span class="logo-text-custom">{{ section.settings.logo_text | default: shop.name }}</span>
        {% endif %}
      </a>
    </div>

    <div></div>

    <nav class="header-grid__menu-wrapper">
      <ul class="header-grid__menu">
        <li class="menu-item-has-children">
          <a href="javascript:void(0)">{{ section.settings.text_1 }}</a>
          <ul class="dropdown-menu">
            {% for i in (1..7) %}
              {% capture d_text %}drop_1_text_{{ i }}{% endcapture %}
              {% capture d_link %}drop_1_link_{{ i }}{% endcapture %}
              {% if section.settings[d_text] != blank %}
                <li>
                  <a href="{{ section.settings[d_link] }}">{{ section.settings[d_text] }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </li>
        <li class="menu-item-has-children">
          <a href="javascript:void(0)">{{ section.settings.text_2 }}</a>
          <ul class="dropdown-menu">
            {% for i in (1..3) %}
              {% capture d_text %}drop_2_text_{{ i }}{% endcapture %}
              {% capture d_link %}drop_2_link_{{ i }}{% endcapture %}
              {% if section.settings[d_text] != blank %}
                <li>
                  <a href="{{ section.settings[d_link] }}">{{ section.settings[d_text] }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
        </li>
        <li>
          <a href="{{ section.settings.link_3 }}">{{ section.settings.text_3 }}</a>
        </li>
        <li>
          <a href="{{ section.settings.link_4 }}">{{ section.settings.text_4 }}</a>
        </li>
      </ul>
    </nav>

    <div class="header-grid__cart">
      <a href="{{ routes.cart_url }}" id="CartDrawerTrigger">
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 6H22L19 16H6L3 6ZM3 6L2.25 3.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M11 19.5C11 20.3284 10.3284 21 9.5 21C8.67157 21 8 20.3284 8 19.5C8 18.6716 8.67157 18 9.5 18C10.3284 18 11 18.6716 11 19.5Z" fill="currentColor"/>
          <path d="M17 19.5C17 20.3284 16.3284 21 15.5 21C14.6716 21 14 20.3284 14 19.5C14 18.6716 14.6716 18 15.5 18C16.3284 18 17 18.6716 17 19.5Z" fill="currentColor"/>
        </svg>
        <span class="cart-count-bubble" id="CartCount" data-count="{{ cart.item_count }}">
          {%- if cart.item_count > 0 -%}{{ cart.item_count }}{%- endif -%}
        </span>
      </a>
    </div>

    <a href="{{ section.settings.btn_link | default: '#' }}" class="header-grid__btn">
      {{ section.settings.btn_text }} →
    </a>
  </header>
</div>

<div class="drawer-overlay" id="drawerOverlay"></div>
<div class="mobile-drawer" id="mobileDrawer">
  <div class="drawer-header">
    <button class="drawer-close" id="closeDrawer">✕</button>
    <div class="drawer-title logo-text-custom">{{ section.settings.logo_text | default: shop.name }}</div>
  </div>
  <div class="drawer-body">
    {% for i in (1..6) %}
      {% capture row_text %}row_text_{{ i }}{% endcapture %}
      {% capture row_link %}row_link_{{ i }}{% endcapture %}
      <a href="{{ section.settings[row_link] }}" class="drawer-row">
        {{ section.settings[row_text] }}
        <svg
          class="ph-arrow-right"
          xmlns="http://www.w3.org/2000/svg"
          width="256"
          height="256"
          fill="none"
          viewBox="0 0 256 256"
        >
          <line x1="128" y1="216" x2="128" y2="40" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
          <polyline points="56 112 128 40 200 112" stroke="currentColor" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endfor %}
    <a href="{{ section.settings.row_link_7 }}" class="drawer-row">{{ section.settings.row_text_7 }}</a>
  </div>
  <div class="drawer-footer">
    <a href="{{ routes.account_login_url }}" class="footer-action">
      <svg
        class="login-svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
      </svg>
      Login
    </a>

    <div class="drawer-localization">
      <div class="localization-trigger">
        <span class="localization-text">Canada | CAD $</span>
        <svg class="dropdown-triangle" width="8" height="8" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 21l-12-18h24z"/>
        </svg>
      </div>
    </div>

    <div class="social-icons">
      <a href="{{ settings.social_instagram_link }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M7 2C4.24 2 2 4.24 2 7v10c0 2.76 2.24 5 5 5h10c2.76 0 5-2.24 5-5V7c0-2.76-2.24-5-5-5H7zm5 5a5 5 0 110 10 5 5 0 010-10zm6.5-.75a1.25 1.25 0 11-2.5 0 1.25 1.25 0 012.5 0zM12 9a3 3 0 100 6 3 3 0 000-6z"/>
        </svg>
      </a>
      <a href="{{ settings.social_youtube_link }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M23 12s0-3.5-.45-5.05a3.1 3.1 0 00-2.18-2.18C18.82 4.32 12 4.32 12 4.32s-6.82 0-8.37.45A3.1 3.1 0 001.45 6.95C1 8.5 1 12 1 12s0 3.5.45 5.05a3.1 3.1 0 002.18 2.18c1.55.45 8.37.45 8.37.45s6.82 0 8.37-.45a3.1 3.1 0 002.18-2.18C23 15.5 23 12 23 12zM10 15.5v-7l6 3.5-6 3.5z"/>
        </svg>
      </a>
      <a href="{{ settings.social_facebook_link }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M24 12c0-6.63-5.37-12-12-12S0 5.37 0 12c0 5.99 4.39 10.95 10.13 11.85v-8.39H7.08V12h3.05V9.41c0-3.02 1.8-4.69 4.55-4.69 1.32 0 2.7.24 2.7.24v2.97h-1.52c-1.5 0-1.97.93-1.97 1.88V12h3.35l-.54 3.46h-2.81v8.39C19.61 22.95 24 17.99 24 12z"/>
        </svg>
      </a>
      <a href="{{ settings.social_pinterest_link }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 4.99 3.05 9.26 7.38 11.09-.1-.94-.19-2.38.04-3.4.21-.92 1.35-5.86 1.35-5.86s-.34-.69-.34-1.7c0-1.59.92-2.77 2.07-2.77.98 0 1.45.73 1.45 1.6 0 .98-.62 2.44-.94 3.8-.27 1.14.57 2.06 1.69 2.06 2.03 0 3.59-2.14 3.59-5.23 0-2.73-1.96-4.64-4.75-4.64-3.24 0-5.14 2.43-5.14 4.94 0 .98.38 2.03.85 2.6.09.11.1.21.07.32-.08.35-.26 1.14-.3 1.3-.05.21-.16.25-.37.15-1.37-.64-2.23-2.65-2.23-4.27 0-3.48 2.53-6.67 7.29-6.67 3.83 0 6.8 2.73 6.8 6.39 0 3.81-2.4 6.88-5.73 6.88-1.12 0-2.17-.58-2.53-1.27l-.69 2.63c-.25.96-.93 2.17-1.38 2.91C9.97 23.88 10.97 24 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/>
        </svg>
      </a>
      <a href="{{ settings.social_tiktok_link }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
          <path d="M17.365 1.552a6.803 6.803 0 0 1-3.994-1.005v10.337a4.472 4.472 0 1 1-4.472-4.472V9.44a8.936 8.936 0 1 0 8.936 8.937V3.576a11.31 11.31 0 0 1-1.47.026v5.23a4.473 4.473 0 1 1-4.473-4.473V1.552c1.257.646 2.713 1.01 4.229 1.01.44 0 .877-.02 1.312-.058z"/>
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const openBtn = document.getElementById('openDrawer');
    const closeBtn = document.getElementById('closeDrawer');
    const drawer = document.getElementById('mobileDrawer');
    const overlay = document.getElementById('drawerOverlay');

    if (openBtn)
      openBtn.onclick = () => {
        drawer.classList.add('is-active');
        overlay.classList.add('is-active');
      };
    if (closeBtn)
      closeBtn.onclick = () => {
        drawer.classList.remove('is-active');
        overlay.classList.remove('is-active');
      };
    if (overlay)
      overlay.onclick = () => {
        drawer.classList.remove('is-active');
        overlay.classList.remove('is-active');
      };

    const menuItems = document.querySelectorAll('.menu-item-has-children');
    menuItems.forEach((item) => {
      const link = item.querySelector('a');
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        menuItems.forEach((i) => {
          if (i !== item) i.classList.remove('is-open');
        });
        item.classList.toggle('is-open');
      });
    });

    document.addEventListener('click', () => {
      menuItems.forEach((item) => item.classList.remove('is-open'));
    });

    if (window.innerWidth <= 767) {
      const buttons = document.querySelectorAll('.header-grid__btn');
      buttons.forEach((btn) => {
        let text = btn.textContent.trim().replace('→', '').trim();
        const words = text.split(' ');
        if (words.length > 1) text = words[0];
        btn.childNodes[0].textContent = text + ' ';
      });
    }
  });
</script>

