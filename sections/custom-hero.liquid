{%- style -%}
  {{ section.settings.font_heading | font_face }}
  {{ section.settings.font_body | font_face }}

  .section-{{ section.id }} {
    display: grid;
    grid-template-columns: auto auto;
    background-color: {{ section.settings.bg_color }};
    font-family: {{ section.settings.font_body.family }}, {{ section.settings.font_body.fallback_families }};
    align-items: center; 
    padding: 40px 0;
  }

  .block-left-{{ section.id }} {
    max-width: 590px;
    margin-left: 18%;
  }

  .hero-left-h4-{{ section.id }} {
    font-family: {{ section.settings.font_heading.family }}, {{ section.settings.font_heading.fallback_families }};
    font-size: 64px;
    color: {{ section.settings.text_color }};  
    line-height: 70px;
    margin-bottom: 0;
  }

  .hero-left-special-font-{{ section.id }} {
    font-family: 'Comforter', cursive !important;
    font-size: 96px;
    color: {{ section.settings.accent_color }};
  }

  .hero-left-p-{{ section.id }} {
    font-size: 20px;
    color: {{ section.settings.text_color }};
    font-weight: 200;
  }

  .hero-left-p-{{ section.id }} strong, 
  .bold-{{ section.id }} {
    font-weight: 600;
  }

  .hero-left-btn-1-{{ section.id }}, 
  .hero-left-btn-2-{{ section.id }} {
    width: 96%;
    font-size: 18px;
    padding: 2.7%;
    border-radius: 8px;
    border: none;
    color: white;
    display: block;
    text-align: center;
    text-decoration: none;
    margin-bottom: 1.8%;
    cursor: pointer;
  }

  .hero-left-btn-1-{{ section.id }} {
    background-color: {{ section.settings.btn_1_bg }};
    font-weight: 800;
    margin-top: 5%;
  }

  .hero-left-btn-2-{{ section.id }} {
    background-color: {{ section.settings.btn_2_bg }};
  }

  .hero-left-rating-{{ section.id }} {
    font-size: 12px;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .hero-rating-container-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .star-group-{{ section.id }} {
    display: flex;
    gap: 2px; 
  }

  .star-{{ section.id }} {
    width: 11px;  
    height: 11px; 
    fill: {{ section.settings.accent_color }};
  }

  .right-image-{{ section.id }} {
    margin-left: 25%;
    max-width: 75%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 992px) {
    .section-{{ section.id }} { grid-template-columns: 1fr; text-align: center; }
    .section-{{ section.id }} .right{order: -1;}
    .right-image-{{ section.id }} { margin-left: auto; margin-right: auto; max-width: 100%; }
  }
  @media screen and (max-width: 768px) {
    
    .block-left-{{ section.id }} { margin-left: auto; margin-right: auto; padding: 0 20px; }
    .hero-left-special-font-{{ section.id }} {font-size: 65px;}
    .hero-left-h4-{{ section.id }} {font-size: 42px; letter-spacing: 1%; line-height: 45px;}
    .hero-left-p-{{ section.id }} {font-size: 16px; font-weight: 400;}
    .hero-left-btn-1-{{ section.id }},.hero-left-btn-2-{{ section.id }} {width: 100%;}
    .hero-rating-container-{{ section.id }} {justify-content: center;}
  }
{%- endstyle -%}

<div class="section-hero section-{{ section.id }}">
    <div class="left">
        {% for block in section.blocks %}
        <div class="block-left block-left-{{ section.id }}" {{ block.shopify_attributes }}>
            <h4 class="hero-left-h4-{{ section.id }}">
                {{ block.settings.text_before }} 
                <span class="hero-left-special-font-{{ section.id }}">{{ block.settings.text_special }}</span>
                {{ block.settings.text_after }}
            </h4>
            
            <div class="hero-left-p-{{ section.id }}">
                {{ block.settings.description }}
            </div>
            
            <a href="{{ block.settings.link_1 }}" class="hero-left-btn-1-{{ section.id }}">{{ block.settings.btn_1_text }} →</a>
            <a href="{{ block.settings.link_2 }}" class="hero-left-btn-2-{{ section.id }}">{{ block.settings.btn_2_text }} →</a>

            <div class="hero-rating-container-{{ section.id }}">
                <div class="star-group-{{ section.id }}">
                    {% for i in (1..5) %}
                    <svg class="star-{{ section.id }}" viewBox="0 0 24 24">
                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                    </svg>
                    {% endfor %}
                </div>
                <p class="hero-left-rating-{{ section.id }} bold-{{ section.id }}">{{ block.settings.rating_text }}</p>
            </div>
        </div>
        {% endfor %}
    </div>
    
    <div class="right">
        {% if section.settings.hero_image != blank %}
            {%- capture img_class -%}right-image-{{ section.id }}{%- endcapture -%}
            {{ section.settings.hero_image | image_url: width: 1000 | image_tag: class: img_class }}
        {% else %}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'right-image' }}
        {% endif %}
    </div>
</div>

{% schema %}
{
  "name": "Coffee Hero",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#075D57"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Gold)",
      "default": "#DEB126"
    },
    {
        "type": "color",
        "id": "btn_1_bg",
        "label": "Button 1 Color",
        "default": "#EF4444"
    },
    {
        "type": "color",
        "id": "btn_2_bg",
        "label": "Button 2 Color",
        "default": "#064A46"
    },
    {
      "type": "font_picker",
      "id": "font_heading",
      "label": "Heading Font",
      "default": "raleway_n4"
    },
    {
      "type": "font_picker",
      "id": "font_body",
      "label": "Body Font",
      "default": "raleway_n4"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Right Image"
    }
  ],
  "blocks": [
    {
      "type": "hero_content",
      "name": "Content Block",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_before", "label": "Text Before Special", "default": "Your" },
        { "type": "text", "id": "text_special", "label": "Special Word", "default": "Perfect" },
        { "type": "text", "id": "text_after", "label": "Text After Special", "default": "Coffee Routine!" },
        { 
          "type": "inline_richtext", 
          "id": "description", 
          "label": "Description", 
          "default": "Discover your tailored at home coffee products & routine as we are your <strong>100% FREE Coffee Concierge!</strong>" 
        },
        { "type": "text", "id": "btn_1_text", "label": "Button 1 Text", "default": "BROWSE ALL PRODUCTS" },
        { "type": "url", "id": "link_1", "label": "Button 1 Link" },
        { "type": "text", "id": "btn_2_text", "label": "Button 2 Text", "default": "TAKE YOUR FREE SURVEY NOW" },
        { "type": "url", "id": "link_2", "label": "Button 2 Link" },
        { "type": "text", "id": "rating_text", "label": "Rating Text", "default": "4.9/5.00 (Serviced 6,000,000+ Coffee Lovers)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Coffee Hero",
      "blocks": [
        { "type": "hero_content" }
      ]
    }
  ]
}
{% endschema %}