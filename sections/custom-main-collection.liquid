<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  /* 1. Global Section Styling & Font */
  @import url('https://fonts.googleapis.com/css2?family=Raleway:wght@400;700;800&display=swap');

  .collection-wrapper-main {
    font-family: 'Raleway', sans-serif;
    padding: 60px 8%;
  }

  .custom-collection-title {
    display: flex;
    font-size: 32px;
    font-weight: 700 !important;
    margin-bottom: 40px;
    color: #424242;
    text-transform: none; /* Matching your h4 design exactly */
  }
  div#product-grid{
    margin-top: 2.5%;
  }
  /* 2. Grid Layout Logic */
  .product-grid-static-{{ section.id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3%;
    width: 100%;
  }

  /* Rule for last row: Max 2 products if incomplete */
  .product-grid-static-{{ section.id }}:after {
    content: "";
    grid-column: span 2;
  }

  /* 3. Product Card Styling (100% Match) */
  .related-product-card-{{ section.id }} {
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.3s ease;
    position: relative;
  }

  .related-image-container-{{ section.id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background-color: #f5f5f5;
  }

  .related-product-image-{{ section.id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Dynamic Tag Badge */
  .dynamic-tag-badge {
    position: absolute;
    top: 12px;
    left: 0px;
    background: #FAE5B9;
    color: #424242;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 800;
    z-index: 2;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .related-product-title-{{ section.id }} {
    font-size: 18px;
    font-weight: 700 !important;
    margin: 15px 0 5px 0;
    color: #424242;
    line-height: 125%;
  }

  .related-review-row-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 10px;
  }

  .related-star-group-{{ section.id }} {
    display: flex;
    gap: 0;
  }

  .star-{{ section.id }} {
    width: 14px;
    height: 14px;
    fill: #EF4444;
  }

  .related-review-count-{{ section.id }} {
    font-weight: 700;
    font-size: 13px;
    margin: 0;
    color: #000;
  }

  .related-price-container-{{ section.id }} {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 15px;
    margin-top: auto;
  }

  .related-real-price-{{ section.id }} {
    font-size: 19px;
    font-weight: 700 !important;
    color: #000;
    margin: 0;
  }

  .related-compare-price-{{ section.id }} {
    text-decoration: line-through;
    color: #929292;
    font-size: 13px;
    font-weight: 400;
    margin: 0;
  }

  .related-add-btn-{{ section.id }} {
    width: 100%;
    font-family: 'Raleway', sans-serif;
    font-weight: 800 !important;
    padding: 12px;
    color: #FFF;
    background-color: #EF4444;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: opacity 0.3s;
    height: 50px;
    font-size: 18px;
  }

  /* 4. Pagination Arrows */
  .custom-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 25px;
    margin-top: 50px;
  }
  .pagination-arrow {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    border: 1px solid #424242;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: #424242;
    font-weight: bold;
    transition: 0.3s;
  }
  .pagination-arrow:hover { background: #424242; color: #fff; }

  @media screen and (max-width: 1024px) {
    .product-grid-static-{{ section.id }} { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 600px) {
    .product-grid-static-{{ section.id }} { grid-template-columns: 1fr; }
    .collection-wrapper-main { padding: 40px 20px; }
  }
{%- endstyle -%}

<div class="collection-wrapper-main section-static-related-{{ section.id }}">
  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when 'collection_heading' -%}
        <h4
          class="custom-collection-title"
          style="margin-bottom: {{ block.settings.margin_bottom }}px; margin-top: {{ block.settings.margin_top }}px;"
        >
          {{ block.settings.title | default: collection.title }}
        </h4>

      {%- when 'filter_bar' -%}
        {% render 'custom-filter-bar', results: collection, sectionId: section.id %}

      {%- when 'product_grid' -%}
        <div id="ProductGridContainer" data-id="{{ section.id }}">
          {% paginate collection.products by 14 %}
            <div id="product-grid" class="product-grid-static-{{ section.id }}" data-id="{{ section.id }}">
              {%- if collection.products.size == 0 -%}
                <div class="jp-empty-state">
                  <p>No products match those filters. <a href="{{ collection.url }}">Clear all</a></p>
                </div>
              {%- endif -%}

              {% for prod in collection.products %}
                <div class="related-product-card-{{ section.id }} js-related-card" data-url="{{ prod.url }}">
                  {%- comment -%} ... KEEP ALL YOUR EXISTING PRODUCT CARD CODE HERE ... {%- endcomment -%}

                  {% if prod.tags.size > 0 %}
                    <span class="dynamic-tag-badge">{{ prod.tags | first }}</span>
                  {% endif %}

                  <div class="related-image-container-{{ section.id }}">
                    <img
                      class="related-product-image-{{ section.id }}"
                      src="{{ prod.featured_image | image_url: width: 600 }}"
                      alt="{{ prod.title | escape }}"
                      loading="lazy"
                      width="{{ prod.featured_image.width }}"
                      height="{{ prod.featured_image.height }}"
                    >
                  </div>

                  <h4 class="related-product-title-{{ section.id }}">{{ prod.title }}</h4>

                  <div class="related-review-row-{{ section.id }}">
                    <div class="related-star-group-{{ section.id }}">
                      {% for i in (1..5) %}
                        <svg class="star-{{ section.id }}" viewBox="0 0 24 24">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      {% endfor %}
                    </div>
                    <p class="related-review-count-{{ section.id }}">
                      ( <u>{{ prod.metafields.custom.review_count.value | default: '1171' }} Reviews</u> )
                    </p>
                  </div>

                  <div class="related-price-container-{{ section.id }}">
                    <p class="related-real-price-{{ section.id }}">{{ prod.price | money }}</p>
                    {% if prod.compare_at_price > prod.price %}
                      <p class="related-compare-price-{{ section.id }}">{{ prod.compare_at_price | money }}</p>
                    {% endif %}
                  </div>

                  <form method="post" action="{{ routes.cart_add_url }}" class="js-related-form">
                    <input type="hidden" name="id" value="{{ prod.variants.first.id }}">
                    <button type="submit" class="related-add-btn-{{ section.id }}">ADD TO CART</button>
                  </form>
                </div>
              {% endfor %}
            </div>

            {% if paginate.pages > 1 %}
              <div class="custom-pagination">
                {% if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="pagination-arrow">&lt;</a>
                {%- endif %}
                <span style="font-weight:700;">{{ paginate.current_page }} / {{ paginate.pages }}</span>
                {% if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="pagination-arrow">&gt;</a>
                {%- endif %}
              </div>
            {% endif %}
          {% endpaginate %}
        </div>
    {%- endcase -%}
  {%- endfor -%}
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Handling click on card (but not on button)
    document.addEventListener('click', function (e) {
      const card = e.target.closest('.js-related-card');
      if (card && !e.target.closest('button') && !e.target.closest('form')) {
        window.location.href = card.getAttribute('data-url');
      }
    });

    // AJAX Add to Cart
    document.addEventListener('submit', function (e) {
      const form = e.target.closest('.js-related-form');
      if (form) {
        e.preventDefault();
        const btn = form.querySelector('button');
        const originalText = btn.innerText;
        btn.innerText = 'ADDING...';
        btn.disabled = true;

        fetch(window.Shopify.routes.root + 'cart/add.js', {
          method: 'POST',
          body: new FormData(form),
        })
          .then((res) => res.json())
          .then((data) => {
            btn.innerText = 'ADDED!';
            if (typeof refreshCartDrawer === 'function') refreshCartDrawer(false);
            setTimeout(() => {
              btn.innerText = originalText;
              btn.disabled = false;
            }, 2000);
          })
          .catch((err) => {
            btn.innerText = 'TRY AGAIN';
            btn.disabled = false;
          });
      }
    });
  });
</script>

{% schema %}
{
  "name": "Custom Collection",
  "blocks": [
    {
      "type": "collection_heading",
      "name": "Main Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading Text" },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Top Spacing",
          "default": 40
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "label": "Bottom Spacing",
          "default": 40
        }
      ]
    },
    { "type": "filter_bar", "name": "JavaPress Filter Bar", "limit": 1 },
    { "type": "product_grid", "name": "Product Grid", "limit": 1 }
  ],
  "presets": [
    {
      "name": "Custom Collection",
      "blocks": [{ "type": "collection_heading" }, { "type": "filter_bar" }, { "type": "product_grid" }]
    }
  ]
}
{% endschema %}
