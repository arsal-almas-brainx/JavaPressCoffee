{%- style -%}
  /* 1. LOAD FONT FROM PICKER */
  {{ section.settings.font_body | font_face: font_display: 'swap' }}
  
  {%- assign font_bold = section.settings.font_body | font_modify: 'weight', 'bold' -%}
  {%- if font_bold -%}
    {{ font_bold | font_face: font_display: 'swap' }}
  {%- endif -%}

  /* 2. APPLY TO ALL ELEMENTS IN SECTION */
  .section-{{ section.id }} * {
    font-family: {{ section.settings.font_body.family }}, {{ section.settings.font_body.fallback_families }} !important;
    box-sizing: border-box;
  }

  .section-newsletter-{{ section.id }} {
      display: flex;
      flex-direction: column; 
      align-items: center;    
      justify-content: center;
      text-align: center;
      padding: 60px 0;
      background-color: #F2F2F2;
  }

  .newsletter-logo-{{ section.id }}{
      width: 40px; 
      height: auto;
      margin-bottom: 10px;
  }

  .newsletter-subscription-{{ section.id }}{
      color: {{ section.settings.sub_heading_color }};
      font-size: 16px;
      font-weight: 700;
      margin: 0 0 10px 0;
  }

  .join-our-{{ section.id }}{
      text-align: center;
      font-size: 32px;
      font-weight: 600;
      color: {{ section.settings.main_heading_color }};
      width: 52%;
      margin: 1% 0;
      line-height: 1.2;
  }

  .discount-line-{{ section.id }}{
      font-weight: 300;
      font-size: 16px;
      margin-top: -1%;
      color: #424242;
  }

  .discount-line-{{ section.id }} span{
      font-size: 20px;
      font-weight: 600;
  }

  /* --- EMAIL BLOCK DESIGN --- */
  .email-container-{{ section.id }}{
      display: flex;
      justify-content: space-between;
      background-color: #D9D9D9;
      width: 55%;
      border-radius: 4px;
      margin-top: 1%;
      align-items: center; 
      overflow: hidden;
  }

  .input-icon-wrapper-{{ section.id }} {
      position: relative;
      display: flex;
      align-items: center;
      flex: 1; 
  }

  .input-icon-{{ section.id }} {
      position: absolute;
      left: 30px;     
      width: 20px;
      height: 20px;
      color: #888A8C;  
      pointer-events: none;
  }

  .email-sub-{{ section.id }}{
      border: none !important;
      background-color: transparent !important;
      width: 100%;
      font-size: 15px;
      padding-left: 58px !important;
      height: 50px !important; /* Forces height to match button container */
      outline: none;
  }

  /* Custom Placeholder Styling */
  .email-sub-{{ section.id }}::placeholder {
      color: #888A8C;
      font-weight: 300;
  }

  .btn-sub-container-{{ section.id }}{
      width: 37.5%;
      height: 62px;
      padding: 0.8%;
  }

  .btn-sub-{{ section.id }}{
      width: 100%;
      height: 100%;
      color: white;
      background-color: {{ section.settings.btn_color }};
      border: none;
      border-radius: 4px;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
  }

  @media (max-width: 768px) {
    .join-our-{{ section.id }}, .email-container-{{ section.id }} {
      width: 90%;
    }
    .btn-sub-container-{{ section.id }} {
      width: 45%;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <div class="section-newsletter-{{ section.id }}">
      
      {% if section.settings.logo != blank %}
        {%- assign logo_class = 'newsletter-logo-' | append: section.id -%}
        {{ section.settings.logo | image_url: width: 100 | image_tag: 
            class: logo_class,
            loading: 'lazy',
            width: section.settings.logo.width,
            height: section.settings.logo.height,
            alt: section.settings.logo.alt | default: "Logo"
        }}
      {% else %}
         <div style="width: 40px; margin-bottom: 10px;">
            {{ 'image' | placeholder_svg_tag }}
         </div>
      {% endif %}

      <h3 class="newsletter-subscription-{{ section.id }}">{{ section.settings.sub_heading }}</h3>
      <h3 class="join-our-{{ section.id }}">{{ section.settings.main_heading }}</h3>
      
      <p class="discount-line-{{ section.id }}">
        {{ section.settings.discount_text_left }} 
        <span>{{ section.settings.discount_highlight }}</span> 
        {{ section.settings.discount_text_right }}
      </p>

      <form method="post" action="/contact#newsletter-footer" class="email-container-{{ section.id }}">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="input-icon-wrapper-{{ section.id }}">
              <svg class="input-icon-{{ section.id }}" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M17 20.5H7C4 20.5 2 19 2 15.5V8.5C2 5 4 3.5 7 3.5H17C20 3.5 22 5 22 8.5V15.5C22 19 20 20.5 17 20.5Z" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
                  <path d="M17 9L13.87 11.5C12.84 12.32 11.15 12.32 10.12 11.5L7 9" stroke="currentColor" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <input 
                type="email" 
                name="contact[email]" 
                class="email-sub-{{ section.id }}" 
                placeholder="{{ section.settings.placeholder }}" 
                required
              >
          </div>
          
          <div class="btn-sub-container-{{ section.id }}">
              <button type="submit" class="btn-sub-{{ section.id }}">
                  {{ section.settings.btn_text }}
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M3 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                      <path d="M21 12L14 16.5V7.5L21 12Z" fill="currentColor" />
                  </svg>
              </button>
          </div>
      </form>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Newsletter Icon/Logo" },
    { "type": "text", "id": "sub_heading", "label": "Sub-heading", "default": "NEWSLETTER SUBSCRIPTION" },
    { "type": "color", "id": "sub_heading_color", "label": "Sub-heading Color", "default": "#035D57" },
    { "type": "text", "id": "main_heading", "label": "Main Heading", "default": "Join Our Newsletter And Get Updates On Promotions And Coupons." },
    { "type": "color", "id": "main_heading_color", "label": "Main Heading Color", "default": "#424242" },
    { "type": "text", "id": "discount_text_left", "label": "Discount Text Left", "default": "Get" },
    { "type": "text", "id": "discount_highlight", "label": "Discount Highlighted Text", "default": "“$20 discount”" },
    { "type": "text", "id": "discount_text_right", "label": "Discount Text Right", "default": "for your first order" },
    { "type": "text", "id": "placeholder", "label": "Input Placeholder", "default": "Your Email Address" },
    { "type": "text", "id": "btn_text", "label": "Button Text", "default": "SUBSCRIBE NOW" },
    { "type": "color", "id": "btn_color", "label": "Button Background Color", "default": "#EF4444" },
    { "type": "font_picker", "id": "font_body", "label": "Font Family", "default": "raleway_n4" }
  ],
  "presets": [
    { "name": "Newsletter Footer" }
  ]
}
{% endschema %}