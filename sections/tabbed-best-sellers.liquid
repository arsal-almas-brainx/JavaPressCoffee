{%- style -%}
  {{ section.settings.font_heading | font_face }}
  {{ section.settings.font_body | font_face }}

  {%- assign font_heading_bold = section.settings.font_heading | font_modify: 'weight', 'bold' -%}
  {%- assign font_body_bold = section.settings.font_body | font_modify: 'weight', 'bold' -%}
  {{ font_heading_bold | font_face }}
  {{ font_body_bold | font_face }}

  :root {
    --tab-gap: 110px;
    --line-color: #EBEAE6;
    --active-color: #AF272F;
  }

  .section-{{ section.id }} {
    font-family: {{ section.settings.font_body.family }}, {{ section.settings.font_body.fallback_families }};
    padding: 60px 0;
    overflow: hidden;
  }

  .try-our-best-h4-{{ section.id }}.bold {
    font-family: {{ section.settings.font_heading.family }}, {{ section.settings.font_heading.fallback_families }};
    display: flex;
    justify-content: center;
    font-size: 32px;
    font-weight: 700 !important;
    margin-bottom: 8%;
    margin-top: 4%;
  }

  .tab-header-wrapper-{{ section.id }} {
    border-bottom: 1px solid var(--line-color);
    width: 100%;
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
  }

  .tab-buttons-{{ section.id }} {
    display: flex;
    gap: var(--tab-gap);
    margin-bottom: -1px;
  }

  .tab-btn-{{ section.id }} {
    background: none;
    border: none;
    padding: 10px 5px 20px 5px;
    cursor: pointer;
    font-size: 18px;
    color: #2D2D2D;
    font-family: inherit;
    border-bottom: 1px solid transparent;
    font-weight: 400;
  }

  .tab-btn-{{ section.id }}.active {
    font-weight: 700 !important;
    border-bottom: 1px solid var(--active-color);
  }

  .tab-pane-{{ section.id }} {
    display: none;
    padding: 0 8%;
    position: relative;
  }

  .tab-pane-{{ section.id }}.active {
    display: block;
  }

  .product-slider-wrapper-{{ section.id }} {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 10px;
  }

  .product-slider-wrapper-{{ section.id }}::-webkit-scrollbar {
    display: none;
  }

  .try-our-product-{{ section.id }} {
    flex: 0 0 calc(25% - 15px);
    min-width: calc(25% - 15px);
    display: flex;
    flex-direction: column;
  }

  .image-container-{{ section.id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    position: relative;
    overflow: hidden;
    border-radius: 4px;
    background-color: #f5f5f5;
  }

  .try-our-product-card-image-{{ section.id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  .try-out-product-card-h4-{{ section.id }} {
    font-family: {{ section.settings.font_heading.family }}, {{ section.settings.font_heading.fallback_families }};
    font-size: 18px;
    font-weight: 700 !important;
    margin: 15px 0 5px 0;
    color: #000;
  }

  .star-{{ section.id }} {
    width: 14px;
    height: 14px;
  }

  .try-our-card-rating-{{ section.id }} {
    font-weight: 700 !important;
    font-size: 13px;
    margin: 0;
  }

  .product-card-real-price-{{ section.id }} {
    font-size: 19px;
    font-weight: 700 !important;
    color: #424242;
    margin: 0;
  }

  .product-card-button-{{ section.id }} {
    width: 100%;
    font-family: inherit;
    font-weight: 800 !important;
    padding: 12px;
    color: #FFF;
    background-color: #EF4444;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 15px;
    transition: opacity 0.3s;
  }

  .slider-nav-{{ section.id }} {
    display: flex;
    justify-content: space-between;
    position: absolute;
    top: 35%;
    left: 2%;
    right: 2%;
    width: 96%;
    pointer-events: none;
    z-index: 10;
  }

  .nav-btn-{{ section.id }} {
    pointer-events: auto;
    background: black;
    color: white;
    border: none;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  }

  .nav-btn-right-{{ section.id }} { transform: translateX(-210%) translateY(-90%); }
  .nav-btn-left-{{ section.id }} { transform: translateX(210%) translateY(-90%); }

  /* New Dot Pagination Styles */
  .dots-container-{{ section.id }} {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
  }

  .dot-{{ section.id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #B9B9B9;
    transition: background-color 0.3s;
  }

  .dot-{{ section.id }}.active {
    background-color: #000000;
  }

  @media screen and (max-width: 992px) {
    .try-our-product-{{ section.id }} { flex: 0 0 calc(50% - 10px); min-width: calc(50% - 10px); }
    .nav-btn-right-{{ section.id }} { transform: translateY(-80%) translateX(-110%); }
    .nav-btn-left-{{ section.id }} { transform: translateY(-80%) translateX(110%); }
  }

  @media screen and (max-width: 767px) {
    .try-our-product-{{ section.id }} { 
      flex: 0 0 calc(50% - 10px); 
      min-width: calc(50% - 10px); 
    }
    .tab-pane-{{ section.id }} { padding: 0 20px; }
    .tab-buttons-{{ section.id }} { gap: 25px; overflow-x: auto; justify-content: flex-start; }
    .tab-header-wrapper-{{ section.id }} { justify-content: flex-start; }
    
    .slider-nav-{{ section.id }} { 
      display: flex; 
      top: 30%;
      left: 5px;
      right: 5px;
      width: calc(100% - 10px);
    }
    .nav-btn-{{ section.id }} { width: 30px; height: 30px; }
    .nav-btn-right-{{ section.id }} { transform: translateY(-130%) translateX(-13px); }
    .nav-btn-left-{{ section.id }} { transform: translateY(-130%) translateX(13px); }

    .dots-container-{{ section.id }} { display: flex; }
    .try-out-product-card-h4-{{ section.id }} {font-size: 16px;}
    .try-our-card-rating-{{ section.id }} {font-size: 12px;}
    .star-{{ section.id }} {width: 10px; height: 10px;}
    .product-card-real-price-{{ section.id }} {font-size: 16px;}
    .product-card-button-{{ section.id }} {font-size: 16px; font-weight: 800;}
  }
{%- endstyle -%}

<div class="section-{{ section.id }}">
  <h4 class="try-our-best-h4-{{ section.id }} bold">{{ section.settings.title }}</h4>

  <div class="tab-header-wrapper-{{ section.id }}">
    <div class="tab-buttons-{{ section.id }}">
      {% for block in section.blocks %}
        <button
          class="tab-btn-{{ section.id }} {% if forloop.first %}active{% endif %}"
          data-target="tab-{{ block.id }}"
        >
          {{ block.settings.tab_title }}
        </button>
      {% endfor %}
    </div>
  </div>

  <div class="tab-content-wrapper-{{ section.id }}">
    {% for block in section.blocks %}
      {%- assign current_collection = block.settings.collection -%}
      <div id="tab-{{ block.id }}" class="tab-pane-{{ section.id }} {% if forloop.first %}active{% endif %}">
        <div class="product-slider-wrapper-{{ section.id }}" id="slider-{{ block.id }}">
          {% if current_collection != blank and current_collection.products_count > 0 %}
            {% for product in current_collection.products %}
              <div class="try-our-product-{{ section.id }}">
                
                <a href="{{ product.url }}" style="text-decoration: none; color: inherit; display: block;">
                  <div class="image-container-{{ section.id }}">
                    {%- assign img_class = 'try-our-product-card-image-' | append: section.id -%}
                    {{ product.featured_image | image_url: width: 600 | image_tag: class: img_class, loading: 'lazy' }}
                  </div>

                  <h4 class="try-out-product-card-h4-{{ section.id }}">{{ product.title }}</h4>
                </a>
                <div style="display:flex; align-items:center; gap:6px; margin-bottom:10px;">
                  <div style="display:flex; gap:2px;">
                    {%- assign product_rating = product.metafields.custom.star_rating.value | default: 5.0 -%}
                    {% for i in (1..5) %}
                      {%- assign diff = product_rating | minus: i | plus: 1 -%}
                      <svg class="star-{{ section.id }}" viewBox="0 0 24 24">
                        <defs>
                          <linearGradient id="star-grad-{{ section.id }}-{{ block.id }}-{{ product.id }}-{{ i }}">
                            <stop offset="{% if diff >= 1 %}100%{% elsif diff > 0 %}{{ diff | times: 100 }}%{% else %}0%{% endif %}" stop-color="#EF4444" />
                            <stop offset="{% if diff >= 1 %}100%{% elsif diff > 0 %}{{ diff | times: 100 }}%{% else %}0%{% endif %}" stop-color="#EBEAE6" />
                          </linearGradient>
                        </defs>
                        <path fill="url(#star-grad-{{ section.id }}-{{ block.id }}-{{ product.id }}-{{ i }})" d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                      </svg>
                    {% endfor %}
                  </div>
                  <p class="try-our-card-rating-{{ section.id }}">
                    ( <u>{{ product.metafields.custom.review_count.value | default: '1171' }} Reviews</u> )
                  </p>
                </div>

                <div style="display:flex; gap:10px; align-items:center; margin-top: auto;">
                  <p class="product-card-real-price-{{ section.id }}">{{ product.price | money }}</p>
                  {% if product.compare_at_price > product.price %}
                    <p style="text-decoration:line-through; color:#929292; font-size:13px; font-weight:400; margin-top:4px;">
                      {{ product.compare_at_price | money }}
                    </p>
                  {% endif %}
                </div>

                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                  <button type="submit" class="product-card-button-{{ section.id }}">ADD TO CART</button>
                </form>
              </div>
            {% endfor %}
          {% else %}
            <p style="text-align:center; width:100%; padding:40px;">No products found.</p>
          {% endif %}
        </div>

        {% if current_collection.products_count > 0 %}
          <div class="slider-nav-{{ section.id }}">
            <button
              class="nav-btn-left-{{ section.id }} nav-btn-{{ section.id }}"
              onclick="slideProducts('slider-{{ block.id }}', -1) "
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              class="nav-btn-right-{{ section.id }} nav-btn-{{ section.id }}"
              onclick="slideProducts('slider-{{ block.id }}', 1)"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
          
          <div class="dots-container-{{ section.id }}" id="dots-{{ block.id }}"></div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sId = '{{ section.id }}';
    const btns = document.querySelectorAll('.tab-btn-' + sId);
    const panes = document.querySelectorAll('.tab-pane-' + sId);

    btns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btns.forEach((b) => b.classList.remove('active'));
        panes.forEach((p) => p.classList.remove('active'));
        btn.classList.add('active');
        const target = document.getElementById(btn.getAttribute('data-target'));
        target.classList.add('active');
        
        const slider = target.querySelector('.product-slider-wrapper-' + sId);
        if(slider) updateDots(slider.id);
      });
    });

    document.querySelectorAll('.product-slider-wrapper-' + sId).forEach(slider => {
      initDots(slider.id);
      slider.addEventListener('scroll', () => updateDots(slider.id));
    });
  });

  function initDots(sliderId) {
    const slider = document.getElementById(sliderId);
    const blockId = sliderId.replace('slider-', '');
    const dotsContainer = document.getElementById('dots-' + blockId);
    if (!dotsContainer) return;

    const products = slider.querySelectorAll('.try-our-product-{{ section.id }}');
    const dotsCount = Math.ceil(products.length / 2);

    dotsContainer.innerHTML = '';
    for (let i = 0; i < dotsCount; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot-{{ section.id }}' + (i === 0 ? ' active' : '');
      dotsContainer.appendChild(dot);
    }
  }

  function updateDots(sliderId) {
    const slider = document.getElementById(sliderId);
    const blockId = sliderId.replace('slider-', '');
    const dotsContainer = document.getElementById('dots-' + blockId);
    if (!dotsContainer || !slider) return;

    const scrollPercentage = slider.scrollLeft / (slider.scrollWidth - slider.clientWidth || 1);
    const dots = dotsContainer.querySelectorAll('.dot-{{ section.id }}');
    if (dots.length === 0) return;
    
    const activeIndex = Math.min(Math.round(scrollPercentage * (dots.length - 1)), dots.length - 1);

    dots.forEach((dot, idx) => {
      dot.classList.toggle('active', idx === activeIndex);
    });
  }

  function slideProducts(id, direction) {
    const container = document.getElementById(id);
    const isMobile = window.innerWidth <= 600;
    const scrollAmount = isMobile ? container.offsetWidth / 2 : container.offsetWidth;
    container.scrollBy({ left: scrollAmount * direction, behavior: 'smooth' });
  }
</script>

{% schema %}
{
  "name": "Try Our Best Sellers",
  "settings": [
    { "type": "text", "id": "title", "label": "Section Title", "default": "Try Our Best Sellers" },
    { "type": "font_picker", "id": "font_heading", "label": "Heading Font", "default": "raleway_n4" },
    { "type": "font_picker", "id": "font_body", "label": "Body Font", "default": "raleway_n4" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Tab",
      "settings": [
        { "type": "text", "id": "tab_title", "label": "Tab Name", "default": "Best Sellers" },
        { "type": "collection", "id": "collection", "label": "Select Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Try Our Best Sellers",
      "blocks": [
        { "type": "tab", "settings": { "tab_title": "Best Sellers" } },
        { "type": "tab", "settings": { "tab_title": "Daily Essentials" } },
        { "type": "tab", "settings": { "tab_title": "Black" } },
        { "type": "tab", "settings": { "tab_title": "Hard" } }
      ]
    }
  ]
}
{% endschema %}