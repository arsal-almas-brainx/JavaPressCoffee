{%- doc -%}
  Renders the sorting component with a grouped border.
{%- enddoc -%}

<sorting-filter-component
  class="sorting-filter{% if filter_style == 'horizontal' %} sorting-filter__horizontal{% endif %}"
  on:change="/updateFilterAndSorting"
  {% if sort_position != blank %}
    data-testid="sorting-filter-component-{{ sort_position }}"
  {% endif %}
  data-should-use-select-on-mobile="{{ should_use_select_on_mobile }}"
>
  {% liquid
    assign current_sort_label = ''
    for option in results.sort_options
      if option.value == sort_by
        assign current_sort_label = option.name
        break
      endif
    endfor

    if current_sort_label == blank
      for option in results.sort_options
        if option.value == results.default_sort_by
          assign current_sort_label = option.name
        endif
      endfor
    endif
  %}

  {% capture accordion_children %}
    <details
      ref="details"
      id="Sorting-{{ section_id }}"
      class="facets__panel {% if should_use_select_on_mobile %} mobile:hidden {% endif %}"
      on:toggle="/handleToggle"
    >
      <summary class="facets__summary" role="button" ref="summary" style="list-style: none;">
        <div class="sorting-header-group">
          <span class="facets__label">
            Sort By:
          </span>
          
          <div class="sort-selector-border">
            <span class="current-sort-name">
              {{- current_sort_label -}}
            </span>
            <span class="filled-triangle">▼</span>
          </div>
        </div>
      </summary>
      
      <floating-panel-component class="sorting-filter__options color-{{ settings.popover_color_scheme }}">
        <div class="sorting-filter__options-inner">
          {% for option in results.sort_options %}
            <label for="sort-option-{{ option.value }}-{{ section_id }}" class="sorting-filter__option-label">
              <div class="sorting-filter__option" role="option">
                <input
                  type="radio"
                  name="sort_by"
                  id="sort-option-{{ option.value }}-{{ section_id }}"
                  value="{{ option.value }}"
                  class="sorting-filter__input"
                  {% if option.value == sort_by %}checked{% endif %}
                >
                <span class="sorting-filter__label">{{ option.name }}</span>
              </div>
            </label>
          {% endfor %}
        </div>
      </floating-panel-component>
    </details>
  {% endcapture %}

  {% render 'accordion-custom-component', children: accordion_children %}
</sorting-filter-component>

{% stylesheet %}
  /* The Outer Wrapper */
  .sorting-header-group {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    margin-left: 180%;
    font-size: 18px;
  }

  /* The Grouped Border around Name and Dropdown Arrow */
  .sort-selector-border {
    display: inline-flex;
    align-items: center;
    gap: 62px;
    padding: 10px 12px;
    border: 1px solid #C4D1D0; /* Change to your preferred border color */
    border-radius: 4px; /* Adjust for rounded or square corners */
    background-color: transparent;
    transition: background-color 0.2s ease;
  }

  .sort-selector-border:hover {
    background-color: rgba(var(--color-foreground-rgb), 0.03);
  }

  .current-sort-name {
    font-weight: 500;
    font-size: 18px;
    color: var(--color-foreground);
    width: 100px;
  }

  /* The Fully Filled Downward Triangle */
  .filled-triangle {
    font-size: 9px;
    line-height: 1;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  details[open] .filled-triangle {
    transform: rotate(180deg);
  }

  /* Dropdown Panel Styling */
  .sorting-filter__options {
    position: absolute;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-popover);
    z-index: 100;
    margin-top: 8px;
    min-width: 200px;
    border-radius: 4px;
  }

  .sorting-filter__option-label {
    display: block;
    width: 100%;
    cursor: pointer;
  }

  .sorting-filter__option {
    padding: 10px 15px;
    transition: background 0.2s;
  }

  .sorting-filter__option:hover {
    background-color: rgba(var(--color-foreground-rgb), 0.05);
  }

  .sorting-filter__input {
    display: none; /* Keep radio hidden */
  }

  /* Ensure summary marker doesn't show in some browsers */
  .facets__summary::-webkit-details-marker {
    display: none;
  }
  .sorting-filter__options {margin-left: 180%;}
{% endstylesheet %}